<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gr_agenda" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- latar kaca: diisi bitmap blur oleh GlassBg; bawaan = kaca gelap tembus pandang -->
    <ImageView android:id="@+id/gw_agenda" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/gw_bg" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/gc_agenda" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
            <TextView android:id="@+id/w_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:minWidth="50dp" />
            <TextView android:id="@+id/w_e1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
            <TextView android:id="@+id/w_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:minWidth="50dp" />
            <TextView android:id="@+id/w_e2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_r3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
            <TextView android:id="@+id/w_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:minWidth="50dp" />
            <TextView android:id="@+id/w_e3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_r4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
            <TextView android:id="@+id/w_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:minWidth="50dp" />
            <TextView android:id="@+id/w_e4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="8dp" />
        </LinearLayout>
        <TextView android:id="@+id/w_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:layout_marginTop="5dp" android:visibility="gone" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/w_tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E6FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:singleLine="true" android:ellipsize="end" android:background="@drawable/gw_chip" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginTop="6dp" />
    </LinearLayout>
</FrameLayout>
