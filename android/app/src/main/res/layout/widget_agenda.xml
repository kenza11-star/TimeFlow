<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bg" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_e1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/w_e2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/w_e3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/w_e4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/w_more" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="12sp" android:visibility="gone" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/w_tasks" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
