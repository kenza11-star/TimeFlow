<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gr_clock" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- latar kaca: diisi bitmap blur oleh GlassBg; bawaan = kaca gelap tembus pandang -->
    <ImageView android:id="@+id/gw_clock" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/gw_bg" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/gc_clock" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
        <TextClock android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="hh:mm" android:textSize="52sp" android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        <TextClock android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="EEEE, d MMMM" android:format12Hour="EEEE, d MMMM" android:textSize="15sp" android:textColor="#B3FFFFFF"
            android:layout_marginTop="2dp" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        <TextView android:id="@+id/w_wx" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:layout_marginTop="8dp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
