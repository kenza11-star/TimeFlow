<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/mw_bg"
    android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:paddingBottom="8dp">

    <LinearLayout android:id="@+id/mw_head" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/mw_art" android:layout_width="56dp" android:layout_height="56dp"
            android:scaleType="centerCrop" android:layout_marginRight="12dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:id="@+id/mw_pos" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF" android:textSize="11sp" />
        <ProgressBar android:id="@+id/mw_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="5dp"
            android:layout_marginLeft="8dp" android:layout_marginRight="8dp"
            android:max="1000" android:progress="0" android:progressDrawable="@drawable/mw_progress" />
        <TextView android:id="@+id/mw_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageButton android:id="@+id/mw_prev" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:background="@null" android:src="@drawable/mw_prev" android:scaleType="centerInside" android:contentDescription="Sebelumnya" />
        <ImageButton android:id="@+id/mw_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:background="@null" android:src="@drawable/mw_pause" android:scaleType="centerInside" android:contentDescription="Putar atau jeda" />
        <ImageButton android:id="@+id/mw_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:background="@null" android:src="@drawable/mw_next" android:scaleType="centerInside" android:contentDescription="Berikutnya" />
    </LinearLayout>
</LinearLayout>
