<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gr_screentime" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- latar kaca: diisi bitmap blur oleh GlassBg; bawaan = kaca gelap tembus pandang -->
    <ImageView android:id="@+id/gw_screentime" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/gw_bg" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/gc_screentime" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <!-- judul + tanggal terpilih + tombol segarkan -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/st_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Waktu pemakaian" android:textSize="13sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/st_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:singleLine="true" android:paddingStart="8dp" />
            <TextView android:id="@+id/st_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" android:textSize="18sp" android:textColor="#B3FFFFFF" android:paddingStart="12dp" android:paddingEnd="2dp" android:contentDescription="Perbarui waktu layar" />
        </LinearLayout>
        <!-- total hari terpilih (+ total hari ini bila hari lain yang dipilih) -->
        <LinearLayout android:id="@+id/st_totalrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp">
            <TextView android:id="@+id/st_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="30sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:fontFamily="sans-serif-light" android:singleLine="true" />
            <TextView android:id="@+id/st_today" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="11sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:singleLine="true" android:ellipsize="end" android:paddingStart="8dp" android:paddingBottom="4dp" />
        </LinearLayout>
        <!-- grafik 7 hari (bitmap) + 7 area ketuk transparan untuk memilih hari -->
        <FrameLayout android:id="@+id/st_chartbox" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="6dp">
            <ImageView android:id="@+id/st_chart" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <FrameLayout android:id="@+id/st_d0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/st_d1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/st_d2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/st_d3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/st_d4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/st_d5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/st_d6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>
        <!-- aplikasi teratas -->
        <LinearLayout android:id="@+id/st_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/st_ar0" android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/st_ai0" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/st_an0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/st_at0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:paddingStart="8dp" android:singleLine="true" />
                </LinearLayout>
                <ProgressBar android:id="@+id/st_ab0" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/st_bar" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/st_ar1" android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/st_ai1" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/st_an1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/st_at1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:paddingStart="8dp" android:singleLine="true" />
                </LinearLayout>
                <ProgressBar android:id="@+id/st_ab1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/st_bar" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/st_ar2" android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/st_ai2" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/st_an2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/st_at2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:paddingStart="8dp" android:singleLine="true" />
                </LinearLayout>
                <ProgressBar android:id="@+id/st_ab2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/st_bar" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/st_ar3" android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/st_ai3" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/st_an3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/st_at3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:paddingStart="8dp" android:singleLine="true" />
                </LinearLayout>
                <ProgressBar android:id="@+id/st_ab3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/st_bar" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/st_ar4" android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/st_ai4" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/st_an4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/st_at4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B3FFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" android:paddingStart="8dp" android:singleLine="true" />
                </LinearLayout>
                <ProgressBar android:id="@+id/st_ab4" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/st_bar" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
        <!-- keadaan kosong / izin belum aktif -->
        <LinearLayout android:id="@+id/st_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:visibility="gone">
            <TextView android:id="@+id/st_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="13sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
            <TextView android:id="@+id/st_grant" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:background="@drawable/gw_pill_on" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                android:text="Buka pengaturan" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF1C1C1E" android:includeFontPadding="false" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
