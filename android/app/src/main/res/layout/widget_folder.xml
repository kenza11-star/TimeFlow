<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Folder App: kartu kaca + 4 ubin ikon (2x2) + judul. Hanya view yang didukung RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gr_folder" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/gw_folder" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/gw_bg" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/gc_folder" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView android:id="@+id/f_t0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:scaleType="fitCenter" android:contentDescription="Aplikasi" />
                <ImageView android:id="@+id/f_t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:scaleType="fitCenter" android:contentDescription="Aplikasi" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView android:id="@+id/f_t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:scaleType="fitCenter" android:contentDescription="Aplikasi" />
                <ImageView android:id="@+id/f_t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:scaleType="fitCenter" android:contentDescription="Aplikasi" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/f_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center" android:textSize="12sp" android:textColor="#E6FFFFFF"
            android:includeFontPadding="false" android:shadowColor="#59000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2"
            android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end" android:text="Folder" />
    </LinearLayout>
</FrameLayout>
