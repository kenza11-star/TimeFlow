<resources>
    <style name="Theme.TimeFlow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tf_white</item>
        <item name="android:statusBarColor">@color/tf_white</item>
        <item name="android:navigationBarColor">@color/tf_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.TimeFlow.Ring" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tf_ink</item>
        <item name="android:statusBarColor">@color/tf_ink</item>
        <item name="android:navigationBarColor">@color/tf_ink</item>
    </style>
    <style name="Theme.TimeFlow.Lock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
