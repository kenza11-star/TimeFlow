<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- cadangan bila latar kabur belum tersedia: kaca bening, tidak keruh -->
    <item>
        <shape android:shape="rectangle"><solid android:color="#4A0E0E12" /><corners android:radius="28dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#46FFFFFF" android:centerColor="#12FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
