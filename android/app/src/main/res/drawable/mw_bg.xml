<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- dasar gelap tembus pandang -->
    <item>
        <shape android:shape="rectangle"><solid android:color="#7A121216" /><corners android:radius="30dp" /></shape>
    </item>
    <!-- kilau kaca: terang di kiri atas, memudar ke kanan bawah -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#40FFFFFF" android:centerColor="#14FFFFFF" android:endColor="#08FFFFFF" />
            <corners android:radius="30dp" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
