<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- cadangan bila latar kabur belum tersedia: kaca bening bergaya glassmorphism -->
    <item>
        <shape android:shape="rectangle"><solid android:color="#40101018" /><corners android:radius="28dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#4DFFFFFF" android:centerColor="#14FFFFFF" android:endColor="#05FFFFFF" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
