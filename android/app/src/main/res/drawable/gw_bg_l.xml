<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- cadangan glassmorphism gaya TERANG: kabut putih tipis + kilau + tepi putih -->
    <item>
        <shape android:shape="rectangle"><solid android:color="#8CFFFFFF" /><corners android:radius="28dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#80FFFFFF" android:centerColor="#33FFFFFF" android:endColor="#1AFFFFFF" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
