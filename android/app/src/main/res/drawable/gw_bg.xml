<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- cadangan bila tangkapan layar belum tersedia (tanpa layanan aksesibilitas / Android < 11): kaca gelap tembus pandang -->
    <item>
        <shape android:shape="rectangle"><solid android:color="#7A101014" /><corners android:radius="28dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#3CFFFFFF" android:centerColor="#0FFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
