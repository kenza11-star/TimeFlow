<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- cadangan bila latar blur belum ada (tanpa layanan aksesibilitas / Android < 11): kaca gelap, cukup pekat supaya teks terbaca -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#B8222230" android:endColor="#B8101018" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#33FFFFFF" android:centerColor="#0DFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
